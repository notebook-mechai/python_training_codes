   "source": [
    "from sympy import symbols, Eq, solve\n",
    "\n",
    "# Define the symbol\n",
    "x = symbols('x')\n",
    "\n",
    "# Define the equation\n",
    "equation = Eq(2*x + 5, 11)\n",
    "\n",
    "# Solve the equation\n",
    "solution = solve(equation, x)\n",
    "print(\"Solution for x is:\", solution[0])\n"
   ]
  }
 ],
